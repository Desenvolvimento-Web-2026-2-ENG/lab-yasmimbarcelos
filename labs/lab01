<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="description" content ="Exemplo de página"> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testes</title>
</head>
<body>
    <header id="cabecalho">
        <div class="titulo">Área de Contato do Cliente</div>
        <nav class="menu">
            <a href="#">Ajuda</a> | <a href="#">Sair</a>
        </nav>
    </header>

    <main id="corpo-da-pagina">
        <h1>Envie sua mensagem para a nossa equipe de suporte backend</h1>
        
        <form action="/enviar" method="POST">
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" required minlength="3"><br><br>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required minlength="10"><br><br>

            <label for="telefone">Telefone:</label>
            <input type="tel" id="telefone" name="celular" required pattern="[0-9]{11}" title="digite seu numero com DDD"><br><br>

            <label for="mensagem">Mensagem:</label>
            <textarea id="mensagem" name="msg"></textarea><br><br>
            
            <input type="submit" value="Disparar Dados">
        </form>
    </main>

    <footer>
        Suporte Tech 2026
    </footer>
</body>
</html>
